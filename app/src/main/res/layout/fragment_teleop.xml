<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".FragmentTeleop"
    android:weightSum="5"
    android:background="@color/medium_blue">

    <com.fro.scoutingapp.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Tele-Op"
        app:color_mode="dark"
        android:layout_weight="0.5"/>

    <com.fro.scoutingapp.RowLargeBox
        android:id="@+id/teleop_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Fuel Scored"
        app:box_type="multi_counter"
        android:layout_weight="1.5"/>

    <com.fro.scoutingapp.RowLargeBox
        android:id="@+id/teleop_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Fuel Collected"
        app:box_type="multi_counter"
        android:layout_weight="1.5"/>

    <com.fro.scoutingapp.RowLargeBox
        android:id="@+id/teleop_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Amount Of Times\nCollected From Outpost"
        app:box_type="counter"
        android:layout_weight="1"/>
</LinearLayout>