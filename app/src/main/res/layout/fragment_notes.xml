<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/night_blue"
    tools:context=".FragmentNotes"
    android:weightSum="5">

    <com.fro.scoutingapp.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Notes"
        app:color_mode="light"
        android:layout_weight="0.5"/>

    <com.fro.scoutingapp.RowLongBox
        android:id="@+id/notes_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:left_text="Did The\nRobot Break"
        app:middle_text="Was The\nRobot Tipped"
        app:right_text="Were There\nAny Penalties"
        app:left_box_type="toggle"
        app:middle_box_type="toggle"
        app:right_box_type="toggle"
        app:color_pattern="white_grey_white"
        android:layout_weight="1"/>

    <com.fro.scoutingapp.RowLargeBox
        android:id="@+id/notes_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Any extra notes, comments, concerns?"
        app:box_type="type_box"
        android:layout_weight="2.5"/>

</LinearLayout>