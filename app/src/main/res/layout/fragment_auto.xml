<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_blue"
    tools:context=".FragmentAuto"
    android:weightSum="5">


    <com.fro.scoutingapptest.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Auto"
        app:color_mode="dark"
        android:layout_weight="0.5">
    </com.fro.scoutingapptest.RowTopText>

    <com.fro.scoutingapptest.RowLargeBox
        android:id="@+id/auto_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Climb?"
        app:box_type="text_dropdown"
        android:layout_weight="1.5">
    </com.fro.scoutingapptest.RowLargeBox>

    <com.fro.scoutingapptest.RowLargeBox
        android:id="@+id/auto_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Fuel Scored\nIn Hub"
        app:box_type="multi_counter"
        android:layout_weight="2.5"/>

</LinearLayout>