<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ActivityMain"
    android:weightSum="5">

    <com.fro.scoutingapp2025.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Template"
        app:color_mode="dark"
        android:layout_weight="0.5"/>

    <com.fro.scoutingapp2025.RowTwoBoxes
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:left_text="GO FRO!!!"
        app:right_text="There is def text here"
        app:left_box_type="toggle"
        app:right_box_type="text_dropdown"
        android:layout_weight="1"/>

    <com.fro.scoutingapp2025.RowThreeBoxes
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:left_text="A thing"
        app:middle_text="muahahah"
        app:right_text="ssjhk"
        app:left_box_type="team_number_dropdown"
        app:middle_box_type="text_type_box"
        app:right_box_type="stopwatch"
        android:layout_weight="1"/>

    <com.fro.scoutingapp2025.RowLongBox
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:left_text="lefty"
        app:middle_text="middle"
        app:right_text="righty"
        app:left_box_type="text_dropdown"
        app:middle_box_type="number_type_box"
        app:right_box_type="text_type_box"
        app:color_pattern="white_grey_white"
        android:layout_weight="1"/>

    <com.fro.scoutingapp2025.RowLargeBox
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Very big box"
        app:box_type="text_dropdown"
        android:layout_weight="1"/>

</LinearLayout>