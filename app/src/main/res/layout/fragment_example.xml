<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ActivityMain"
    android:weightSum="5"
    android:background="@color/fro_blue">

<!--TODO: DELETE THIS FILE AND FragmentExample.java BEFORE APP USE -->

    <com.fro.scoutingapp.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Example"
        app:color_mode="light"
        android:layout_weight="0.4"/>

    <com.fro.scoutingapp.RowTopImage
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:image="@drawable/game_logo"
        app:color_mode="light"
        android:layout_weight="0.4"/>

    <com.fro.scoutingapp.RowTwoBoxes
        android:id="@+id/template_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:left_text="Points Scored"
        app:right_text="Robot Did Thing"
        app:left_box_type="counter"
        app:right_box_type="toggle"
        android:layout_weight="1"/>

    <com.fro.scoutingapp.RowThreeBoxes
        android:id="@+id/template_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:left_text="Dropdown Here"
        app:middle_text="Team Number"
        app:right_text="A Stopwatch"
        app:left_box_type="text_dropdown"
        app:middle_box_type="team_number_dropdown"
        app:right_box_type="stopwatch"
        android:layout_weight="1"/>

    <com.fro.scoutingapp.RowLongBox
        android:id="@+id/template_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:left_text="Input"
        app:middle_text="Points Not\nScored"
        app:right_text="Nothing"
        app:left_box_type="type_box"
        app:middle_box_type="counter"
        app:right_box_type="nothing"
        app:color_pattern="white_grey_white"
        android:layout_weight="1"/>

    <com.fro.scoutingapp.RowLargeBox
        android:id="@+id/template_row_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Piece Scored"
        app:box_type="multi_counter"
        android:layout_weight="1"/>

</LinearLayout>