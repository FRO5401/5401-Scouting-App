<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/backgroundLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:layout_marginTop="10dp"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp"
    android:background="@drawable/box_background"
    android:weightSum="5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:weightSum="2">
        <TextView
            android:id="@+id/vertical_long_box_text_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:padding="20dp"
            android:gravity="center"
            android:textColor="@color/text_grey"
            android:fontFamily="@font/helvetica_bold"
            android:layout_weight="1"/>
        <com.fro.scoutingapptest.ComponentFlipper
            android:id="@+id/vertical_long_box_flipper_1"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/light_grey"
        android:weightSum="2">
        <TextView
            android:id="@+id/vertical_long_box_text_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:padding="20dp"
            android:gravity="center"
            android:textColor="@color/text_grey"
            android:fontFamily="@font/helvetica_bold"
            android:layout_weight="1"/>
        <com.fro.scoutingapptest.ComponentFlipper
            android:id="@+id/vertical_long_box_flipper_2"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:weightSum="2">
        <TextView
            android:id="@+id/vertical_long_box_text_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:padding="20dp"
            android:gravity="center"
            android:textColor="@color/text_grey"
            android:fontFamily="@font/helvetica_bold"
            android:layout_weight="1"/>
        <com.fro.scoutingapptest.ComponentFlipper
            android:id="@+id/vertical_long_box_flipper_3"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/light_grey"
        android:weightSum="2">
        <TextView
            android:id="@+id/vertical_long_box_text_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:padding="20dp"
            android:gravity="center"
            android:textColor="@color/text_grey"
            android:fontFamily="@font/helvetica_bold"
            android:layout_weight="1"/>
        <com.fro.scoutingapptest.ComponentFlipper
            android:id="@+id/vertical_long_box_flipper_4"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:weightSum="2">
        <TextView
            android:id="@+id/vertical_long_box_text_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:padding="20dp"
            android:gravity="center"
            android:textColor="@color/text_grey"
            android:fontFamily="@font/helvetica_bold"
            android:layout_weight="1"/>
        <com.fro.scoutingapptest.ComponentFlipper
            android:id="@+id/vertical_long_box_flipper_5"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

</LinearLayout>