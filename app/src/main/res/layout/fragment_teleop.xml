<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".FragmentTeleop"
    android:weightSum="5"
    android:background="@color/medium_blue">

    <com.fro.scoutingapptest.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Tele-Op"
        app:color_mode="dark"
        android:layout_weight="0.5">
    </com.fro.scoutingapptest.RowTopText>

    <com.fro.scoutingapptest.RowLargeBox
        android:id="@+id/teleop_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Fuel Scored\nIn Hub"
        app:box_type="multi_counter"
        android:layout_weight="3.5">
    </com.fro.scoutingapptest.RowLargeBox>

</LinearLayout>