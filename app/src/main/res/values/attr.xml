<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TemplateBoxes">
        <attr name="left_text" format="string" />
        <attr name="middle_text" format="string" />
        <attr name="right_text" format="string" />
        <attr name="text" format="string"/>
        <attr name="image" format="reference"/>

        <attr name="left_box_type" format="enum" >
            <enum name="text_type_box" value="0"/>
            <enum name="number_type_box" value="1"/>
            <enum name="text_dropdown" value="2"/>
            <enum name="team_number_dropdown" value="3"/>
            <enum name="toggle" value="4"/>
            <enum name="counter" value="5"/>
            <enum name="stopwatch" value="6"/>
        </attr>

        <attr name="middle_box_type" format="enum" >
            <enum name="text_type_box" value="0"/>
            <enum name="number_type_box" value="1"/>
            <enum name="text_dropdown" value="2"/>
            <enum name="team_number_dropdown" value="3"/>
            <enum name="toggle" value="4"/>
            <enum name="counter" value="5"/>
            <enum name="stopwatch" value="6"/>
        </attr>

        <attr name="right_box_type" format="enum" >
            <enum name="text_type_box" value="0"/>
            <enum name="number_type_box" value="1"/>
            <enum name="text_dropdown" value="2"/>
            <enum name="team_number_dropdown" value="3"/>
            <enum name="toggle" value="4"/>
            <enum name="counter" value="5"/>
            <enum name="stopwatch" value="6"/>
        </attr>

        <attr name="box_type" format="enum" >
            <enum name="text_type_box" value="0"/>
            <enum name="number_type_box" value="1"/>
            <enum name="text_dropdown" value="2"/>
            <enum name="team_number_dropdown" value="3"/>
            <enum name="toggle" value="4"/>
            <enum name="counter" value="5"/>
            <enum name="stopwatch" value="6"/>
        </attr>

        <attr name="color_pattern" format="enum" >
            <enum name="white_grey_white" value="0"/>
            <enum name="grey_white_grey" value="1"/>
        </attr>

        <attr name="color_mode" format="enum" >
            <enum name="light" value="0"/>
            <enum name="dark" value="1"/>
        </attr>

    </declare-styleable>

</resources>