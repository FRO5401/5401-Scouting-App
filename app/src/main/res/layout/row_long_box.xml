<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/two_boxes_background_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:weightSum="3.3"
    android:layout_marginBottom="10dp"
    android:layout_marginTop="10dp"
    android:layout_marginStart="30dp"
    android:layout_marginEnd="30dp"
    android:background="@drawable/box_background">

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.05"/>

    <LinearLayout
        android:layout_width="0dp"
        android:orientation="vertical"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:weightSum="5">
        <TextView
            android:id="@+id/two_boxes_left_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:textAlignment="center"
            android:textColor="@color/text_grey"
            android:layout_weight="2"
            android:padding="10dp"/>
        <com.fro.scoutingapp.ComponentFlipper
            android:id="@+id/two_boxes_left_flipper"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"/>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.05"/>
    <View
        android:id="@+id/two_boxes_middle_view_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@color/light_grey"
        android:layout_weight="0.05"/>

    <LinearLayout
        android:id="@+id/two_boxes_middle_layout"
        android:layout_width="0dp"
        android:orientation="vertical"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/light_grey"
        android:weightSum="5">
        <TextView
            android:id="@+id/two_boxes_middle_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:textAlignment="center"
            android:textColor="@color/text_grey"
            android:layout_weight="2"
            android:padding="10dp"/>

        <com.fro.scoutingapp.ComponentFlipper
            android:id="@+id/two_boxes_middle_flipper"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"/>
    </LinearLayout>

    <View
        android:id="@+id/two_boxes_middle_view_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@color/light_grey"
        android:layout_weight="0.05"/>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.05"/>

    <LinearLayout
        android:layout_width="0dp"
        android:orientation="vertical"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:weightSum="5">
        <TextView
            android:id="@+id/two_boxes_right_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            tools:text="Text\nHere"
            android:autoSizeTextType="uniform"
            android:layout_margin="10dp"
            android:textAlignment="center"
            android:textColor="@color/text_grey"
            android:layout_weight="2"
            android:padding="10dp"/>
        <com.fro.scoutingapp.ComponentFlipper
            android:id="@+id/two_boxes_right_flipper"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"/>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.05"/>

</LinearLayout>