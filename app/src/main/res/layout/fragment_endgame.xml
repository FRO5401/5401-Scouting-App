<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_blue"
    tools:context=".FragmentEndgame"
    android:weightSum="5">

    <com.fro.scoutingapp.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Endgame"
        app:color_mode="light"
        android:layout_weight="0.5">
    </com.fro.scoutingapp.RowTopText>

    <com.fro.scoutingapp.RowLargeBox
        android:id="@+id/endgame_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="End Position"
        app:box_type="text_dropdown"
        android:layout_weight="1.75"/>

    <com.fro.scoutingapp.RowLargeBox
        android:id="@+id/endgame_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Robot Started Climbing At This Time (seconds)"
        app:box_type="type_box"
        android:layout_weight="1.75"/>
</LinearLayout>