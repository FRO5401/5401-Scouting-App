<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_blue"
    tools:context=".FragmentEndgame"
    android:weightSum="4">

    <com.fro.scoutingapp2025.RowTopText
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Endgame"
        app:color_mode="light"
        android:layout_weight="0.5">
    </com.fro.scoutingapp2025.RowTopText>

    <com.fro.scoutingapp2025.RowThinLargeBox
        android:id="@+id/endgame_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="End Location"
        app:box_type="text_dropdown"
        android:layout_weight="1">
    </com.fro.scoutingapp2025.RowThinLargeBox>

    <com.fro.scoutingapp2025.RowThinLargeBox
        android:id="@+id/endgame_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Robot Spent the\nLast 10 Seconds Doing"
        app:box_type="text_dropdown"
        android:layout_weight="1">
    </com.fro.scoutingapp2025.RowThinLargeBox>

    <com.fro.scoutingapp2025.RowThinLargeBox
        android:id="@+id/endgame_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:text="Started Climbing At\nThis Time (in seconds)"
        app:box_type="type_box"
        android:layout_weight="1">
    </com.fro.scoutingapp2025.RowThinLargeBox>

</LinearLayout>